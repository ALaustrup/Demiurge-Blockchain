# Demiurge Production Secrets Template
# Copy to .secrets and fill with real values
# Generate with: ./scripts/deploy.sh generate-secrets

# JWT Secrets - Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_BASE64_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_BASE64_SECRET

# Database - Generate with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9'
DATABASE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
