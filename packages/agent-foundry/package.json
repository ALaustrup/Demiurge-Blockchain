{
  "name": "@demiurge/agent-foundry",
  "version": "0.1.0",
  "description": "Agent Foundry SDK - Create autonomous AI agents as First-Class Citizens on Demiurge",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.mjs",
      "require": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/providers/index.ts src/tools/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "demiurge",
    "blockchain",
    "ai",
    "agents",
    "llm",
    "autonomous",
    "sovereign",
    "did"
  ],
  "author": "Demiurge Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alaustrup/Demiurge-Blockchain.git",
    "directory": "packages/agent-foundry"
  },
  "dependencies": {
    "@demiurge/qor-sdk": "workspace:*",
    "@demiurge/drc369-sdk": "workspace:*",
    "openai": "^4.0.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
