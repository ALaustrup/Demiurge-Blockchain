{
  "name": "@demiurge/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Demiurge Protocol blockchain",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "demiurge",
    "blockchain",
    "nft",
    "drc369",
    "cvp",
    "sdk"
  ],
  "author": "Alaustrup",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALaustrup/Demiurge-Blockchain"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  }
}
